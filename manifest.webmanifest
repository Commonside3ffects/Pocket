{
 "name": "Pocket",
 "short_name": "Pocket",
 "description": "Private 50/30/20 budget, expense and debt tracker. Data stays on this device.",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#151829",
 "theme_color": "#151829",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml",
   "purpose": "any"
  }
 ],
 "share_target": {
  "action": "./share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "image",
     "accept": [
      "image/*"
     ]
    }
   ]
  }
 }
}